# For Hostinger (LiteSpeed/Apache) web hosting. Ignored by other hosts.
# HTTPS redirects are handled by hPanel's "Force HTTPS" setting.
RewriteEngine On

# Client-side routing: anything that isn't a real file gets index.html,
# so links like /room/ABCD/board work on refresh.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

<IfModule mod_headers.c>
  # Hashed build files never change; index.html must always be re-checked.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
