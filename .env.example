# Copy to .env (git-ignored). Read by docker compose and the Makefile.
# There are no secrets here: the PocketBase superuser is created on first run.

# Image to build, push and run. Use your own registry/user.
BUZZWIRE_IMAGE=ghcr.io/danish12196/buzzwire
BUZZWIRE_TAG=latest

# Host port the container is published on. Point Nginx Proxy Manager at it.
BUZZWIRE_PORT=8090

# Frontend only: where the browser finds PocketBase when the app is hosted
# separately (CI sets it for the Hostinger build). Leave unset for local dev
# and the all-in-one image.
# VITE_PB_URL=https://pb-db.danishali.dev
